generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  passwordHash String
  role         String     // "CUSTOMER" | "ADMIN" | "TECHNICIAN"
  fullName     String
  phone        String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  cases        Case[]
  auditLogs    AuditLog[]
}

model Technician {
  id           String        @id @default(cuid())
  fullName     String
  email        String        @unique
  phone        String?
  active       Boolean       @default(true)
  createdAt    DateTime      @default(now())

  appointments Appointment[]
}

model Product {
  id            String   @id @default(cuid())
  name          String
  category      String
  pestTarget    String
  regularPrice  Float
  deliveryCost  Float
  description   String   @db.NVarChar(Max)
  contents      String   @db.NVarChar(Max) // JSON-encoded string[]
  instructions  String   @db.NVarChar(Max) // JSON-encoded string[]
  safetyNotice  String   @db.NVarChar(Max)
  badge         String?
  imageUrl      String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Case {
  id                  String    @id @default(cuid())
  referenceNumber     String    @unique
  propertyName        String
  customerName        String
  customerEmail       String
  customerPhone       String
  propertyAddress     String
  postcode            String
  pest                String
  location            String
  status              String    @default("NEW") // see CaseStatus values in app code
  productName         String
  deliveryFee         Float
  orderDate           DateTime  @default(now())
  trackingNumber      String?
  courier             String?
  monitoringDay       Int       @default(0)
  monitoringDaysTotal Int       @default(7)
  activityReported    String?
  activityNotes       String?   @db.NVarChar(Max)
  lastReportedDate    DateTime?

  appointmentDate     DateTime?
  appointmentTime     String?
  appointmentStatus   String?
  technicianName      String?
  technicianNotes     String?   @db.NVarChar(Max)

  userId              String?
  user                User?     @relation(fields: [userId], references: [id])

  timelineEntries     TimelineEntry[]
  photos              Photo[]
  proofingQuote       ProofingQuote?
  appointments        Appointment[]
  activityReports     ActivityReport[]
  orders              Order[]
  documents           Document[]

  createdAt           DateTime  @default(now())
  updatedAt            DateTime @updatedAt
}

model TimelineEntry {
  id        String   @id @default(cuid())
  caseId    String
  case      Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  title     String
  date      DateTime @default(now())
  completed Boolean  @default(false)
  current   Boolean  @default(false)
  details   String?  @db.NVarChar(Max)
  author    String?
  createdAt DateTime @default(now())
}

model Photo {
  id        String   @id @default(cuid())
  caseId    String
  case      Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  url       String
  createdAt DateTime @default(now())
}

model ActivityReport {
  id            String   @id @default(cuid())
  caseId        String
  case          Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  activityLevel String
  notes         String?  @db.NVarChar(Max)
  photoUrl      String?
  createdAt     DateTime @default(now())
}

model Appointment {
  id           String      @id @default(cuid())
  caseId       String
  case         Case        @relation(fields: [caseId], references: [id], onDelete: Cascade)
  technicianId String?
  technician   Technician? @relation(fields: [technicianId], references: [id])
  date         DateTime
  time         String
  status       String      @default("Scheduled")
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
}

model ProofingQuote {
  id                    String    @id @default(cuid())
  caseId                String    @unique
  case                  Case      @relation(fields: [caseId], references: [id], onDelete: Cascade)
  reference             String?
  description           String    @db.NVarChar(Max)
  technicianExplanation String    @db.NVarChar(Max)
  findings              String?   @db.NVarChar(Max) // JSON-encoded ProofingFinding[]
  materials             String?
  materialsCost         Float?
  labourCost            Float?
  subtotal              Float?
  price                 Float?
  vat                   Float
  total                 Float
  validUntil            DateTime
  status                String    @default("pending") // "pending" | "accepted" | "declined"
  acceptedAt            DateTime?
  createdAt             DateTime  @default(now())
}

model Order {
  id              String   @id @default(cuid())
  orderNumber     String   @unique
  caseId          String
  case            Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  productName     String
  productPrice    Float
  deliveryFee     Float
  total           Float
  status          String   @default("Preparing") // "Delivered" | "In Transit" | "Preparing" | "Cancelled"
  carrier         String?
  trackingNumber  String?
  placedDate      DateTime @default(now())
  deliveryDate    DateTime?
  propertyAddress String
}

model Document {
  id       String   @id @default(cuid())
  caseId   String
  case     Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  title    String
  category String   // "Instructions" | "Receipt" | "Report" | "Quote" | "Certificate"
  format   String   @default("PDF")
  date     DateTime @default(now())
  size     String?
  fileUrl  String?
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  entityType String
  entityId   String
  action     String
  details    String?  @db.NVarChar(Max)
  createdAt  DateTime @default(now())
}