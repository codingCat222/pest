// This is your Prisma schema file for the Pest Control backend.
// Database: Microsoft SQL Server
// Provider: sqlserver

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
//  Enumerations (mapped to nvarchar in MSSQL)
// ─────────────────────────────────────────────

enum UserRole {
  CUSTOMER
  ADMIN
  TECHNICIAN
}

enum CaseStatus {
  NEW
  ELIGIBILITY_CHECK
  PRODUCT_CLAIMED
  AWAITING_DELIVERY_PAYMENT
  DELIVERY_PAID
  DISPATCHED
  DELIVERED
  MONITORING
  ACTIVITY_REPORTED
  PROFESSIONAL_OFFERED
  PROFESSIONAL_BOOKED
  PROFESSIONAL_COMPLETED
  FOLLOW_UP_MONITORING
  PROOFING_RECOMMENDED
  PROOFING_QUOTE_SENT
  PROOFING_ACCEPTED
  PROOFING_BOOKED
  PROOFING_COMPLETED
  RESOLVED
  CLOSED
  CANCELLED
}

enum PestType {
  RATS_OR_MICE
  BEDBUGS
  COCKROACHES
  FOXES
  ANTS
  OTHER
  NOT_SURE
}

enum ActivityLocation {
  INSIDE_HOME
  GARAGE
  LOFT_ROOF_SPACE
  GARDEN_OUTSIDE
  COMMERCIAL_PROPERTY
  OTHER
}

enum DurationOption {
  LESS_THAN_A_WEEK
  ONE_TO_FOUR_WEEKS
  ONE_TO_THREE_MONTHS
  LONGER
}

enum OrderStatus {
  PREPARING
  IN_TRANSIT
  DELIVERED
  CANCELLED
}

enum AppointmentStatus {
  PENDING
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum QuoteStatus {
  PENDING
  ACCEPTED
  DECLINED
}

enum DocumentCategory {
  INSTRUCTIONS
  RECEIPT
  REPORT
  QUOTE
  CERTIFICATE
}

enum Severity {
  HIGH
  MEDIUM
  LOW
}

enum ActivityLevel {
  NO_ACTIVITY
  LESS_ACTIVITY
  SAME_ACTIVITY
  MORE_ACTIVITY
  NOT_SURE
}

// ─────────────────────────────────────────────
//  Core Models
// ─────────────────────────────────────────────

model User {
  id                String    @id @default(cuid())
  email             String    @unique
  passwordHash      String
  role              UserRole  @default(CUSTOMER)
  firstName         String
  lastName          String
  phone             String?
  isEmailVerified   Boolean   @default(false)
  emailVerifyToken  String?
  resetToken        String?
  resetTokenExpiry  DateTime?
  refreshToken      String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  // Relations
  cases             Case[]
  notifications     Notification[]

  @@map("users")
}

model Case {
  id                   String           @id @default(cuid())
  referenceNumber      String           @unique
  propertyName         String
  propertyAddress      String
  postcode             String
  pest                 PestType
  activityLocation     ActivityLocation
  duration             DurationOption?
  status               CaseStatus       @default(NEW)
  monitoringDay        Int              @default(0)
  monitoringDaysTotal  Int              @default(7)
  activityReported     ActivityLevel?
  activityNotes        String?          @db.NVarChar(Max)
  lastReportedDate     DateTime?
  technicianName       String?
  technicianNotes      String?          @db.NVarChar(Max)
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  // Relations
  customerId           String
  customer             User             @relation(fields: [customerId], references: [id])
  product              Product?         @relation(fields: [productId], references: [id])
  productId            String?
  order                Order?
  appointment          Appointment?
  proofingQuote        ProofingQuote?
  activityReports      ActivityReport[]
  timeline             TimelineEvent[]
  documents            Document[]
  photos               CasePhoto[]
  sightings            CaseSighting[]

  @@map("cases")
}

model Product {
  id            String   @id @default(cuid())
  name          String
  category      String
  pestTarget    PestType
  regularPrice  Decimal  @db.Decimal(10, 2)
  deliveryCost  Decimal  @db.Decimal(10, 2)
  description   String   @db.NVarChar(Max)
  badge         String?
  imageUrl      String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  cases         Case[]
  productContents  ProductContent[]
  instructions  ProductInstruction[]

  @@map("products")
}

model ProductContent {
  id         String  @id @default(cuid())
  productId  String
  item       String
  sortOrder  Int     @default(0)
  product    Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_contents")
}

model ProductInstruction {
  id         String  @id @default(cuid())
  productId  String
  step       String  @db.NVarChar(Max)
  sortOrder  Int     @default(0)
  product    Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_instructions")
}

model Order {
  id              String      @id @default(cuid())
  orderNumber     String      @unique
  caseId          String      @unique
  case            Case        @relation(fields: [caseId], references: [id])
  productPrice    Decimal     @db.Decimal(10, 2) @default(0)
  deliveryFee     Decimal     @db.Decimal(10, 2)
  total           Decimal     @db.Decimal(10, 2)
  status          OrderStatus @default(PREPARING)
  carrier         String?
  trackingNumber  String?
  placedAt        DateTime    @default(now())
  deliveredAt     DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@map("orders")
}

model Appointment {
  id              String            @id @default(cuid())
  caseId          String            @unique
  case            Case              @relation(fields: [caseId], references: [id])
  appointmentDate DateTime
  appointmentTime String            // e.g. "10:00 AM"
  status          AppointmentStatus @default(SCHEDULED)
  technicianName  String?
  notes           String?           @db.NVarChar(Max)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@map("appointments")
}

model ActivityReport {
  id             String        @id @default(cuid())
  caseId         String
  case           Case          @relation(fields: [caseId], references: [id])
  activityLevel  ActivityLevel
  notes          String?       @db.NVarChar(Max)
  reportedAt     DateTime      @default(now())
  photos         ActivityReportPhoto[]

  @@map("activity_reports")
}

model ActivityReportPhoto {
  id               String         @id @default(cuid())
  activityReportId String
  activityReport   ActivityReport @relation(fields: [activityReportId], references: [id], onDelete: Cascade)
  url              String
  filename         String
  uploadedAt       DateTime       @default(now())

  @@map("activity_report_photos")
}

model CasePhoto {
  id         String   @id @default(cuid())
  caseId     String
  case       Case     @relation(fields: [caseId], references: [id])
  url        String
  filename   String
  uploadedAt DateTime @default(now())

  @@map("case_photos")
}

model CaseSighting {
  id       String @id @default(cuid())
  caseId   String
  case     Case   @relation(fields: [caseId], references: [id])
  sighting String // e.g. "Live rodent", "Droppings", etc.

  @@map("case_sightings")
}

model ProofingQuote {
  id                     String      @id @default(cuid())
  reference              String      @unique
  caseId                 String      @unique
  case                   Case        @relation(fields: [caseId], references: [id])
  description            String      @db.NVarChar(Max)
  technicianExplanation  String      @db.NVarChar(Max)
  materials              String?     @db.NVarChar(Max)
  materialsCost          Decimal?    @db.Decimal(10, 2)
  labourCost             Decimal?    @db.Decimal(10, 2)
  subtotal               Decimal?    @db.Decimal(10, 2)
  vat                    Decimal     @db.Decimal(10, 2)
  total                  Decimal     @db.Decimal(10, 2)
  validUntil             DateTime
  status                 QuoteStatus @default(PENDING)
  acceptedAt             DateTime?
  createdAt              DateTime    @default(now())
  updatedAt              DateTime    @updatedAt

  findings               ProofingFinding[]

  @@map("proofing_quotes")
}

model ProofingFinding {
  id                String        @id @default(cuid())
  quoteId           String
  quote             ProofingQuote @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  title             String
  description       String        @db.NVarChar(Max)
  recommendedWork   String        @db.NVarChar(Max)
  imageUrl          String?
  severity          Severity
  sortOrder         Int           @default(0)

  @@map("proofing_findings")
}

model TimelineEvent {
  id          String   @id @default(cuid())
  caseId      String
  case        Case     @relation(fields: [caseId], references: [id])
  title       String
  details     String?  @db.NVarChar(Max)
  author      String?
  completed   Boolean  @default(false)
  isCurrent   Boolean  @default(false)
  eventDate   DateTime @default(now())
  createdAt   DateTime @default(now())

  @@map("timeline_events")
}

model Document {
  id        String           @id @default(cuid())
  caseId    String
  case      Case             @relation(fields: [caseId], references: [id])
  title     String
  category  DocumentCategory
  format    String           @default("PDF")
  url       String
  filename  String
  sizeBytes Int?
  createdAt DateTime         @default(now())

  @@map("documents")
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  title     String
  message   String   @db.NVarChar(Max)
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@map("notifications")
}

model EligibilitySubmission {
  id               String           @id @default(cuid())
  pest             PestType
  activityLocation ActivityLocation
  duration         DurationOption
  fullName         String
  email            String
  phone            String
  address          String
  postcode         String
  approved         Boolean          @default(false)
  createdAt        DateTime         @default(now())

  @@map("eligibility_submissions")
}
